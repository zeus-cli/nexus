{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexus:contracts:v1:tool_spec",
  "title": "NEXUS Tool Spec v1",
  "description": "Catálogo de ferramenta. access_level EXECUTE/ADMIN exige política própria antes de execução.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool_id",
    "version",
    "description",
    "risk",
    "access",
    "execution_mode",
    "idempotent",
    "timeout_s",
    "input_schema",
    "output_schema",
    "required_capabilities",
    "resource_limits",
    "reversible",
    "metadata"
  ],
  "properties": {
    "tool_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "risk": {
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "access": {
      "enum": ["READ", "WRITE", "EXECUTE", "ADMIN"]
    },
    "execution_mode": {
      "enum": ["HOST", "SANDBOX"]
    },
    "idempotent": {
      "type": "boolean"
    },
    "timeout_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "resource_limits": {
      "type": "object"
    },
    "reversible": {
      "type": "boolean"
    },
    "metadata": {
      "type": "object"
    }
  }
}
