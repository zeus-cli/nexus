# NEXUS — configuração do backup baseline (T7.5)
# Copie para config/backup.env e ajuste. O arquivo backup.env não é versionado.
#
# O repositório deve ficar fora de /home (disco externo ou montagem de rede):
# a unit systemd do backup roda com ProtectHome=read-only.

NEXUS_BACKUP_REPO=/mnt/nexus-backup/restic
NEXUS_BACKUP_PASSWORD_FILE=/home/nexus/.config/nexus/restic-password
NEXUS_BACKUP_KEEP_DAILY=7
NEXUS_BACKUP_KEEP_WEEKLY=4
NEXUS_BACKUP_CHECK_DATA=0
